{
  "name": "@dianel/pi-hooks-rules",
  "version": "0.1.0",
  "description": "Manage Pi tool hooks through /hooks and inject rules automatically",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "hooks",
    "rules"
  ],
  "files": [
    "index.ts",
    "hooks.json",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "pi": {
