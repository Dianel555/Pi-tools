{
  "name": "pi-tools-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for maintained Pi extensions and packages",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "pack:check": "npm pack --workspaces --dry-run",
    "check": "npm run typecheck && npm test && npm run pack:check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
